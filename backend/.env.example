# Copy this file to .env and fill in what you need. Every value below has
# a safe default in code, so RAKSHA runs fully with an empty .env — these
# just unlock the "live" versions of a couple of features.

# Port the API + Socket.io server listens on
PORT=5000

# Must match the frontend origin(s). Comma-separate multiple values, e.g.
# for a Vercel deploy: https://raksha.vercel.app,https://raksha-git-main-you.vercel.app
CORS_ORIGIN=http://localhost:5173

# --- AI Hazard Assistant ---------------------------------------------
# Optional. Without this, the AI Assistant tab still fully works using a
# rule-based safety-tip engine. Add a key to upgrade it to live Claude
# reasoning over the current incident feed.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Smart Safe Routing -----------------------------------------------
# Optional override. Defaults to the public OSRM demo server, which is
# rate-limited and best-effort (see README). Point this at your own OSRM
# instance for production use.
OSRM_BASE_URL=https://router.project-osrm.org

# --- Admin dashboard (demo-grade auth, see README Production Roadmap) --
ADMIN_PASSCODE=raksha-demo
ADMIN_TOKEN_SECRET=change-this-to-a-random-string-before-deploying
